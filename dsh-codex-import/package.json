{
  "name": "dsh-codex-import",
  "version": "0.3.0",
  "description": "Unified import page for Codex App and Claude Code history: handoff summary by default, full transcript on request, same-path projects merge into existing workspaces",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session"
      ],
      "platform": "web"
    }
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": {
    "name": "kialajin"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "import",
    "codex",
    "claude-code",
    "session",
    "migration"
  ],
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {}
}
