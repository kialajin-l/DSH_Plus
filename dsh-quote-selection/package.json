{
  "name": "@kialajin/dsh-quote-selection",
  "version": "0.3.3",
  "description": "Select any transcript text and push it into the composer as a Markdown quote",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session"
      ],
      "platform": "web"
    }
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": {
    "name": "kialajin"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "quote",
    "selection",
    "composer",
    "input"
  ],
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kialajin-l/DSH_Plus.git",
    "directory": "dsh-quote-selection"
  },
  "homepage": "https://github.com/kialajin-l/DSH_Plus/tree/main/dsh-quote-selection#readme",
  "bugs": {
    "url": "https://github.com/kialajin-l/DSH_Plus/issues"
  }
}
