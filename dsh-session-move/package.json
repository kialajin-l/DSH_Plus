{
  "name": "@kialajin/dsh-session-move",
  "version": "0.1.2",
  "description": "Move a cold historical DSH session between registered workspaces, safely and with rollback",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session"
      ],
      "platform": "web"
    }
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": {
    "name": "kialajin"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "session",
    "move",
    "workspace",
    "organize"
  ],
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kialajin-l/DSH_Plus.git",
    "directory": "dsh-session-move"
  },
  "homepage": "https://github.com/kialajin-l/DSH_Plus/tree/main/dsh-session-move#readme",
  "bugs": {
    "url": "https://github.com/kialajin-l/DSH_Plus/issues"
  }
}
